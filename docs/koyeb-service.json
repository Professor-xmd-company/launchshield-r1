{
  "app_id": "2d6db6f0-f8cd-4de3-b6b9-bd06204fc5c6",
  "name": "web",
  "definition": {
    "name": "web",
    "type": "WEB",
    "git": {
      "repository": "github.com/Professor-xmd-company/launchshield-r1",
      "branch": "main",
      "docker": {
        "dockerfile": "Dockerfile"
      },
      "no_deploy_on_push": true,
      "sha": "869ffca6cfd24b770cbcb88c67c4415995173578"
    },
    "regions": [
      "fra"
    ],
    "instance_types": [
      {
        "type": "free"
      }
    ],
    "scalings": [
      {
        "scopes": [
          "region:fra"
        ],
        "min": 0,
        "max": 1,
        "targets": [
          {
            "sleep_idle_delay": {
              "value": 0,
              "deep_sleep_value": 3900,
              "light_sleep_value": 0
            }
          }
        ]
      }
    ],
    "ports": [
      {
        "port": 8080,
        "protocol": "http"
      }
    ],
    "routes": [
      {
        "port": 8080,
        "path": "/"
      }
    ],
    "env": [
      {
        "key": "PORT",
        "value": "8080"
      },
      {
        "key": "LAUNCHSHIELD_DATA_DIR",
        "value": "/data/launchshield"
      },
      {
        "key": "LAUNCHSHIELD_LIVE_TARGETS",
        "value": "https://launchshield-r1-professorcj-43cf1823.koyeb.app"
      },
      {
        "key": "GEMINI_MODEL",
        "value": "gemini-3.5-flash-lite"
      },
      {
        "key": "GEMINI_API_KEY",
        "secret": "launchshield-r1-gemini"
      },
      {
        "key": "LAUNCHSHIELD_PROVIDER_COOLDOWNS",
        "value": "{\"xlogs\":\"2026-10-24T18:02:39.084601+00:00\",\"website_trigger\":\"2026-10-24T18:02:39.084601+00:00\"}"
      }
    ],
    "health_checks": [
      {
        "http": {
          "port": 8080,
          "path": "/healthz",
          "method": "GET"
