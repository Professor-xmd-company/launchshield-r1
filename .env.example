# Server-side only. Do not commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LAUNCHSHIELD_DATA_DIR=./data
# Comma-separated exact public origins explicitly approved by the owner.
LAUNCHSHIELD_LIVE_TARGETS=
PORT=8080

# Optional operator-supplied upstream quota cooldowns across ephemeral redeploys.
# JSON map of quota name to UTC ISO date; not a frontend/user option.
LAUNCHSHIELD_PROVIDER_COOLDOWNS={}
