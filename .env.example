# Server-side only. Do not commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LAUNCHSHIELD_DATA_DIR=./data
# Optional fixed-origin allowlist when public submissions are disabled.
LAUNCHSHIELD_LIVE_TARGETS=
PORT=8080

# Optional operator-supplied upstream quota cooldowns across ephemeral redeploys.
# JSON map of provider to {until,observed_at,source,http_status}. Use verified upstream429/checkpoint evidence.
# Never initialize a cooldown to deployment time + a window. No target-less Website Auditor restart hold.
LAUNCHSHIELD_PROVIDER_COOLDOWNS={}

# Real website submissions with visible permission/public-provider disclosure.
LAUNCHSHIELD_ALLOW_PUBLIC_TARGETS=true
# Never enable on the public service; fixtures are for isolated tests only.
LAUNCHSHIELD_ALLOW_MOCK=false

# Optional operator-only, max30-minute UTC window; default disabled.
# One non-scanning xlogs GET per startup window, no target or scan opt-in header.
# Never solve its checkpoint or use this to start/evade a scan.
LAUNCHSHIELD_DIAGNOSTICS_UNTIL=

# Optional deliberate local xlogs per-target interval, seconds. Provider60/IP/hour remains enforced.
LAUNCHSHIELD_XLOGS_TARGET_INTERVAL=0
